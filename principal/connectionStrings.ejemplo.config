<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla para instalación en cliente.
  1. Copie estos valores a Configuración → Conexión a base de datos (o edite Sisges Pro.exe.config).
  2. Use un usuario de PostgreSQL con permisos solo sobre esa base (no use "postgres" en producción).
  3. Pulse Guardar con "Cifrar al guardar" activado.
  No incluya contraseñas reales en el control de versiones.
-->
<connectionStrings>
  <add name="ConnectionString"
       connectionString="Server=IP_DEL_SERVIDOR; DATABASE=produccion_cliente_; User ID=sisges; Password=CAMBIAR; Port=5432"/>
</connectionStrings>
